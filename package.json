{
  "name": "socialclub-launcher",
  "version": "1.3.0",
  "description": "Launcher propio para servidor NeoForge 1.21.1 (cuentas offline, mods incluidos)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "test": "node test/logic.test.js"
  },
  "author": "Alvaro",
  "license": "MIT",
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@xmcl/core": "^2.12.1",
    "@xmcl/installer": "^5.3.0",
    "adm-zip": "^0.6.1",
    "minecraft-server-util": "^5.4.4",
    "prismarine-auth": "^3.1.1",
    "skinview3d": "^3.4.2",
    "tar": "^7.5.22"
  },
  "overrides": {
    "@xmcl/unzip": "2.1.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "private": true,
  "build": {
    "appId": "dev.socialclub.launcher",
    "productName": "SocialClub SMP",
    "files": [
      "main.js",
      "preload.js",
      "launcher.config.json",
      "lib/**",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "modpack",
        "to": "modpack"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
